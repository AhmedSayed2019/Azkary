diff --git a/libraries/quran_library-4.2.1/lib/src/audio/controller/extensions/ayah_repeat_ctrl_extension.dart b/libraries/quran_library-4.2.1/lib/src/audio/controller/extensions/ayah_repeat_ctrl_extension.dart
